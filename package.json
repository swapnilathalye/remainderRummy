{
  "name": "remainder-rummy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remainder Rummy — a card game where sets share a remainder and the divisor shifts mid-round.",
  "scripts": {
    "test": "node test/engine.test.mjs",
    "bundle": "node tools/bundle.mjs",
    "set-app-id": "node tools/set-app-id.mjs",
    "serve": "node tools/serve.mjs",
    "sync": "npm run bundle && cap sync",
    "android:add": "cap add android",
    "ios:add": "cap add ios",
    "android:open": "cap open android",
    "icons": "capacitor-assets generate --iconBackgroundColor '#160f1c' --splashBackgroundColor '#160f1c'"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/app": "6.0.2",
    "@capacitor/core": "6.2.0",
    "@capacitor/haptics": "6.0.2",
    "@capacitor/ios": "6.2.0",
    "@capacitor/splash-screen": "6.0.3",
    "@capacitor/status-bar": "6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "6.2.0",
    "esbuild": "0.24.2"
  }
}
