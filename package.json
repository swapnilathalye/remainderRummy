{
  "name": "remainder-rummy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remainder Rummy \u2014 a card game where sets share a remainder and the divisor shifts mid-round.",
  "scripts": {
    "test": "node test/engine.test.mjs",
    "bundle": "node tools/bundle.mjs",
    "set-app-id": "node tools/set-app-id.mjs",
    "serve": "node tools/serve.mjs",
    "sync": "npm run bundle && cap sync",
    "android:add": "cap add android",
    "ios:add": "cap add ios",
    "android:open": "cap open android",
    "icons": "capacitor-assets generate --iconBackgroundColor '#160f1c' --splashBackgroundColor '#160f1c'"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "esbuild": "0.24.2"
  }
}